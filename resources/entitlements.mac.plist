<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Required for spawning the AI CLI agent via node-pty. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Required for Electron when running Node modules. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Required so spawned helper processes (CLI agents) can inherit. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Network access for skill catalog + auto-updater. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
