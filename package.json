{
  "name": "trayline",
  "version": "1.0.0",
  "description": "Visual AI workflow automation for people who work, not people who code.",
  "main": "dist-electron/main/index.js",
  "author": "drlecks",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "dev": "vite",
    "predev": "pnpm run rebuild:electron",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3,keytar,node-pty",
    "rebuild:node": "electron-rebuild -f -w better-sqlite3,keytar,node-pty",
    "postinstall": "electron-rebuild -f -w better-sqlite3,keytar,node-pty",
    "pretest": "pnpm run rebuild:node",
    "posttest": "pnpm run rebuild:electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:mac": "pnpm run build && electron-builder --mac",
    "dist:win": "pnpm run build && electron-builder --win",
    "dist:linux": "pnpm run build && electron-builder --linux",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-label": "2.1.11",
    "@radix-ui/react-slot": "1.3.0",
    "@types/adm-zip": "0.5.8",
    "@types/archiver": "7.0.0",
    "@types/pdfkit": "0.17.6",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "5.5.0",
    "adm-zip": "0.5.18",
    "dotenv": "16.6.1",
    "archiver": "7.0.1",
    "better-sqlite3": "12.11.1",
    "chokidar": "3.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cron-parser": "5.6.1",
    "docx": "9.7.1",
    "electron-store": "8.2.0",
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0",
    "fast-glob": "3.3.3",
    "imapflow": "1.4.6",
    "keytar": "7.9.0",
    "lucide-react": "0.469.0",
    "node-cron": "4.6.0",
    "node-pty": "1.1.0",
    "nodemailer": "8.0.11",
    "pdfkit": "0.19.1",
    "react-hook-form": "7.81.0",
    "tailwind-merge": "2.6.1",
    "zod": "3.25.76",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@electron/rebuild": "4.1.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "20.19.43",
    "@types/node-cron": "3.0.11",
    "@types/nodemailer": "8.0.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.2",
    "electron": "31.7.7",
    "electron-builder": "24.13.3",
    "eslint": "9.39.4",
    "postcss": "8.5.16",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vite-plugin-electron": "0.28.8",
    "vite-plugin-electron-renderer": "0.14.7",
    "vitest": "2.1.9"
  },
  "build": {
    "appId": "com.trayline.app",
    "productName": "Trayline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**",
      "**/node_modules/bindings/**",
      "**/node_modules/node-pty/**"
    ],
    "extraResources": [
      {
        "from": "resources/templates",
        "to": "templates"
      },
      {
        "from": "resources/author-prompt.md",
        "to": "author-prompt.md"
      },
      {
        "from": "resources/icon-fill-128.png",
        "to": "icon-fill-128.png"
      },
      {
        "from": "resources/example-project",
        "to": "example-project"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "drlecks",
        "repo": "trayline",
        "releaseType": "prerelease"
      }
    ],
    "mac": {
      "icon": "resources/icon-fill-1024.png",
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "icon": "resources/icon-fill-1024.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "resources/icon-fill-1024.png",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
